# 复制成 /root/project/PM/.env.sms 并填真实值，然后 chmod 600
# 阿里云 RAM 账号需要有 dysms:SendSms 权限（AliyunDysmsFullAccess 也可以）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名名称（必须是在阿里云短信控制台已审核通过的签名）
ALIYUN_SMS_SIGN_NAME=
# 模板 CODE（默认就是下面这个，可留空）
ALIYUN_SMS_TEMPLATE_CODE=SMS_512630691
ALIYUN_SMS_REGION=cn-hangzhou
